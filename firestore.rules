rules_version = '2';

// DUMMY RULES - tighten before going to production.
// - Clients may READ menu and orders.
// - Clients may NOT write to `menu` or `orders` at all.
//   Orders are created/updated only by Cloudflare Functions using the
//   Firebase service account (Admin credentials bypass these rules).
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is the Admin.
    // Replace 'OWNER_UID_HERE' with the actual UID from Firebase Auth.
    function isAdmin() {
      return request.auth != null && request.auth.uid == '4sKSGq7LRxT2mYFOvlI4Dtaso3D2';
    }

    match /menu/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      // Customers read their own order via document ID.
      // Admins can read all orders and update statuses (e.g., mark as Completed).
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      // Public clients read the schedule. Admins can update it.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
