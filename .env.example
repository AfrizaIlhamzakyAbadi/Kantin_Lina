# ============================================================
# Kantin Lina - Environment Variables (TEMPLATE)
# Copy this file:  .env.example  ->  .env          (frontend / Vite)
# and create:      .dev.vars                       (Cloudflare Functions, local)
# NEVER commit .env or .dev.vars. Only this example file is committed.
# ============================================================

# ------------------------------------------------------------
# FRONTEND (goes in `.env`) - exposed to the browser.
# Vite only exposes variables prefixed with VITE_.
# Firebase Console > Project Settings > General > Your apps > SDK setup
# ------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Midtrans CLIENT key is public-safe (used by the frontend if needed).
# Midtrans Dashboard > Settings > Access Keys
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# BACKEND (goes in `.dev.vars` locally, and in Cloudflare Pages
# > Settings > Environment variables for production).
# These are SECRETS - never prefix them with VITE_.
# ------------------------------------------------------------
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx

# "false" = Sandbox (testing), "true" = Production
MIDTRANS_IS_PRODUCTION=false

# Firebase service account (used ONLY by webhook.js to mark orders as paid).
# Firebase Console > Project Settings > Service accounts > Generate new private key
# Paste values from the downloaded JSON file.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
